rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function isStaff() {
      return request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'staff');
    }

    // Accommodations (tents/cottages)
    match /accommodations/{accommodationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Availability logs
    match /availability/{availabilityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings
    match /bookings/{bookingId} {
      // Guests can read their own booking if they know the booking ID
      allow read: if true;
      
      // Bookings should ideally be created via Cloud Function (transactions)
      // But if client-side writes are allowed for draft bookings, enforce pending state
      allow create: if request.resource.data.status == 'pending' 
                    && request.resource.data.totalAmount > 0;
                    
      allow update, delete: if isStaff();
    }

    // Blog Posts
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Programmatic SEO Pages
    match /seoPages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Offers
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Enquiries (Contact Form submissions)
    match /enquiries/{enquiryId} {
      allow read: if isStaff();
      allow create: if request.resource.data.name != null 
                    && request.resource.data.email != null 
                    && request.resource.data.message != null;
      allow update, delete: if isStaff();
    }

    // Settings (Camp Config, WhatsApp & Live Rates)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Site Content
    match /siteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isStaff();
    }
  }
}
